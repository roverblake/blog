# Copy this file to .env.local for local development.
# On Railway, set each of these in your service's "Variables" tab.
# Never commit real values.

# --- Site ---
# The public address of the site, with no trailing slash.
SITE_URL=http://localhost:3000

# --- Database (Railway PostgreSQL) ---
# Railway fills this in automatically when you add a Postgres database and
# reference it from the web service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/blake

# --- Sign-in (Better Auth) ---
# A long random string. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as SITE_URL.
BETTER_AUTH_URL=http://localhost:3000
# The one email address that gets the ADMIN role (access to /studio).
ADMIN_EMAIL=

# --- Email (Resend) ---
# From resend.com > API Keys.
RESEND_API_KEY=
# The "from" address for all mail. Must be on your Resend-verified domain.
EMAIL_FROM="Blake Johnson <letters@example.com>"

# --- Image storage (Railway bucket, S3-compatible) ---
# Railway shows these on the bucket's "Credentials" tab.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Scheduled publishing (Railway cron) ---
# A long random string; the cron job sends it so nobody else can trigger publishing.
CRON_SECRET=

# --- Image storage alternative (Railway volume) ---
# If S3_BUCKET is empty, images are saved to this folder instead.
# On Railway, attach a volume to the web service mounted at /data and set:
# MEDIA_DIR=/data/media
MEDIA_DIR=

# --- Testing only ---
# A password (8+ characters) that lets you sign in to /studio without email.
# DELETE THIS before launch.
TEST_ADMIN_PASSWORD=
